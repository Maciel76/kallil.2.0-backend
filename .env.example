PORT=5000
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster0.xxxxx.mongodb.net/kallil
JWT_SECRET=uma_chave_secreta_forte_aqui_123456
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Usada para montar a URL de webhook que cada lojista cadastra no Mercado Pago
# (precisa ser um dominio publico https - o MP nao alcanca localhost)
BACKEND_URL=https://kallil.net

# IA - DeepSeek (você paga por todos os negócios)
# Coloque sua chave da DeepSeek aqui. Revogue a chave compartilhada no chat e gere uma nova.
DEEPSEEK_API_KEY=sk-INSIRA_SUA_CHAVE_AQUI
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_ENABLED=true

# Mercado Pago do lojista (PIX no PDV)
# Chave AES-256 usada para cifrar o Access Token de cada cliente no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ficar vazia, o backend gera e salva em backend/.encryption-key.
# NUNCA troque essa chave depois: os tokens ja salvos deixam de abrir.
MP_ENCRYPTION_KEY=

# Opcional: sobrepoe BACKEND_URL so para a URL de webhook do lojista
# WEBHOOK_BASE_URL=https://kallil.net
